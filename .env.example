# Optional defaults. MAY also runs locally without an OpenAI API key.
MAY_AI_MODE=auto
MAY_OPENAI_MODEL=gpt-6-astra
MAY_IMAGE_MODEL=gpt-image-2.5-flare
MAY_IMAGE_EDIT_MODEL=gpt-image-2.5-sunburst
MAY_IMAGE_QUALITY=high
MAY_IMAGE_SIZE=auto
MAY_OLLAMA_MODEL=qwen2.5:3b-instruct

# Prefer the API KEY button, which saves the key in Windows Credential Manager.
# Alternatively, set OPENAI_API_KEY in your Windows user environment.
# Never commit a real key to this file.
OPENAI_API_KEY=

# MAY uses local Piper voices. No text-to-speech API key is needed.
